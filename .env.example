# Reference values for Render's Environment settings. Never commit a real key.
# Neither entry point automatically loads .env files.
DO_MODEL_ACCESS_KEY=replace-in-render-secret-settings
DO_MODEL=llama-4-maverick
DEMO_REQUESTS_PER_HOUR=60
# On Render, RENDER_EXTERNAL_URL supplies the origin automatically.
# Set PUBLIC_ORIGIN only for a custom domain or a local WSGI smoke run.
# PUBLIC_ORIGIN=https://your-service.onrender.com
